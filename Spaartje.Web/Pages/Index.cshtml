@page
@model Spaartje.Web.Pages.IndexModel

@{
    ViewData["Title"] = "Home";
}

<h2>Welcome to Spaartje 🪙</h2>
<p>Your personal financial dashboard.</p>

@if (User.Identity!.IsAuthenticated)
{
    <p>You are logged in as <strong>@User.Identity.Name</strong>.</p>
    <p><a asp-page="/Dashboard">Go to your Dashboard →</a></p>
}
else
{
    <p>Please <a asp-page="/Login">login</a> or <a asp-page="/Register">create an account</a> to get started.</p>
}