@page
@model Spaartje.Web.Pages.Transactions.EditModel
@using Spaartje.Domain.Models

@{
    ViewData["Title"] = "Edit Transaction";
}

<a asp-page="/Transactions/Index" style="display:inline-block; margin-bottom:16px; color:#2c3e50; text-decoration:none; font-size:14px;">
    ← Back to Transactions
</a>

<h2>Edit Transaction</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div style="background:#f8f9fa; border:1px solid #ddd; padding:20px; border-radius:6px; max-width:500px;">
    <form method="post">

        @* Hidden field — sends the transaction Id with the POST so we know which one to update *@
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Input.Description">Description</label>
            <input asp-for="Input.Description" type="text" placeholder="e.g. Weekly groceries" />
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Amount">Amount (€)</label>
            <input asp-for="Input.Amount" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="Input.Amount" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Date">Date</label>
            <input asp-for="Input.Date" type="date" />
            <span asp-validation-for="Input.Date" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Type">Type</label>
            <select asp-for="Input.Type" asp-items="Model.TransactionTypeOptions"
                    style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Input.CategoryId">Category</label>
            <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions"
                    style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                <option value="">-- Select a category --</option>
            </select>
            <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
        </div>

        <button type="submit">Save Changes</button>

        <a asp-page="/Transactions/Index"
           style="margin-left:12px; color:#666; text-decoration:none; font-size:14px;">
            Cancel
        </a>

    </form>
</div>