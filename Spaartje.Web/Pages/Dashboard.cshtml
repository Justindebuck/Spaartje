@page
@model Spaartje.Web.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div style="max-width:900px; margin:0 auto; padding:0 16px;">

    <h2>Dashboard</h2>

    <!-- Summary Cards -->
    <div style="display:flex; gap:16px; margin-bottom:32px; flex-wrap:wrap;">

        <div style="flex:1; min-width:180px; background:#d4edda; border:1px solid #c3e6cb; border-radius:8px; padding:20px; text-align:center;">
            <div style="font-size:14px; color:#155724; margin-bottom:6px;">Total Income</div>
            <div style="font-size:28px; font-weight:bold; color:#155724;">
                €@Model.Summary?.TotalIncome.ToString("F2")
            </div>
        </div>

        <div style="flex:1; min-width:180px; background:#f8d7da; border:1px solid #f5c6cb; border-radius:8px; padding:20px; text-align:center;">
            <div style="font-size:14px; color:#721c24; margin-bottom:6px;">Total Expenses</div>
            <div style="font-size:28px; font-weight:bold; color:#721c24;">
                €@Model.Summary?.TotalExpenses.ToString("F2")
            </div>
        </div>

        <div style="flex:1; min-width:180px; background:@(Model.Summary?.Balance >= 0 ? "#d4edda" : "#f8d7da"); border:1px solid @(Model.Summary?.Balance >= 0 ? "#c3e6cb" : "#f5c6cb"); border-radius:8px; padding:20px; text-align:center;">
            <div style="font-size:14px; color:@(Model.Summary?.Balance >= 0 ? "#155724" : "#721c24"); margin-bottom:6px;">Balance</div>
            <div style="font-size:28px; font-weight:bold; color:@(Model.Summary?.Balance >= 0 ? "#155724" : "#721c24");">
                €@Model.Summary?.Balance.ToString("F2")
            </div>
        </div>

    </div>

    @if (Model.Summary?.CategoryBreakdown.Any() == true)
    {
        <!-- Charts Section -->
        <div style="display:flex; gap:24px; margin-bottom:32px; flex-wrap:wrap;">

            <!-- Bar Chart -->
            <div style="flex:2; min-width:280px; background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px;">
                <h3 style="margin-top:0; font-size:16px; color:#2c3e50;">Expenses per Category</h3>
                <canvas id="barChart"></canvas>
            </div>

            <!-- Pie Chart -->
            <div style="flex:1; min-width:220px; background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px;">
                <h3 style="margin-top:0; font-size:16px; color:#2c3e50;">Spending Breakdown</h3>
                <canvas id="pieChart"></canvas>
            </div>

        </div>

        @if (Model.BudgetSummaries?.Any() == true)
{
    <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px; margin-bottom:32px;">
        <h3 style="margin-top:0; font-size:16px; color:#2c3e50;">
            Budget Overview — @DateTime.Now.ToString("MMMM yyyy")
        </h3>

        @foreach (var budget in Model.BudgetSummaries)
        {
            var percentage = Math.Min((double)budget.PercentageUsed, 100);
            var barColour  = budget.IsOverBudget ? "#e74c3c"
                           : budget.PercentageUsed >= 75 ? "#f39c12"
                           : "#2ecc71";
            var textColour = budget.IsOverBudget ? "#e74c3c" : "#2c3e50";

            <div style="margin-bottom:20px;">

                <!-- Category name and amounts -->
                <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                    <span style="font-weight:bold; color:#2c3e50;">@budget.CategoryName</span>
                    <span style="font-size:14px; color:@textColour;">
                        @if (budget.IsOverBudget)
                        {
                            <span style="font-weight:bold;">OVER BUDGET</span>
                            <span> — €@budget.SpentThisMonth.ToString("F2") / €@budget.BudgetLimit.ToString("F2")</span>
                        }
                        else
                        {
                            <span>€@budget.SpentThisMonth.ToString("F2") / €@budget.BudgetLimit.ToString("F2")</span>
                            <span style="color:#666;"> (@budget.PercentageUsed%)</span>
                        }
                    </span>
                </div>

                <!-- Progress bar background -->
                <div style="background:#e0e0e0; border-radius:4px; height:16px; overflow:hidden;">
                    <!-- Filled portion -->
                    <div style="width:@(percentage)%; background:@barColour; height:100%; border-radius:4px; transition:width 0.3s;">
                    </div>
                </div>

                <!-- Remaining amount -->
                @if (!budget.IsOverBudget)
                {
                    <div style="font-size:12px; color:#666; margin-top:4px;">
                        €@budget.Remaining.ToString("F2") remaining this month
                    </div>
                }
                else
                {
                    <div style="font-size:12px; color:#e74c3c; margin-top:4px;">
                        €@Math.Abs(budget.Remaining).ToString("F2") over budget
                    </div>
                }

            </div>
        }
    </div>
}

        <!-- Category Breakdown Table -->
        <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px; margin-bottom:32px;">
            <h3 style="margin-top:0; font-size:16px; color:#2c3e50;">Category Breakdown</h3>
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                    <thead>
                        <tr style="background-color:#2c3e50; color:white;">
                            <th style="padding:10px; text-align:left;">Category</th>
                            <th style="padding:10px; text-align:right;">Income</th>
                            <th style="padding:10px; text-align:right;">Expenses</th>
                            <th style="padding:10px; text-align:right;">Transactions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Summary.CategoryBreakdown)
                        {
                            <tr style="border-bottom:1px solid #ddd;">
                                <td style="padding:10px;">@category.CategoryName</td>
                                <td style="padding:10px; text-align:right; color:#27ae60; font-weight:bold;">
                                    €@category.TotalIncome.ToString("F2")
                                </td>
                                <td style="padding:10px; text-align:right; color:#e74c3c; font-weight:bold;">
                                    €@category.TotalExpenses.ToString("F2")
                                </td>
                                <td style="padding:10px; text-align:right;">
                                    @category.TransactionCount
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:40px; text-align:center; color:#666; margin-bottom:32px;">
            <p style="margin:0;">No transactions yet. Add some transactions to see your financial overview.</p>
            <a asp-page="/Transactions/Index" style="display:inline-block; margin-top:12px; color:#2c3e50;">
                Add your first transaction →
            </a>
        </div>
    }

    <!-- Quick Links -->
    <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <a asp-page="/Transactions/Index"
           style="background:#2c3e50; color:white; padding:10px 20px; border-radius:4px; text-decoration:none; font-size:14px;">
            My Transactions
        </a>
        <a asp-page="/Categories/Index"
           style="background:#7f8c8d; color:white; padding:10px 20px; border-radius:4px; text-decoration:none; font-size:14px;">
            My Categories
        </a>
    </div>

</div>

<!-- Chart.js Scripts -->
<script>
    const labels = [@Html.Raw(string.Join(",", Model.Summary.CategoryBreakdown.Select(c => $"\"{c.CategoryName}\"")))];
    const expenses = [@Html.Raw(string.Join(",", Model.Summary.CategoryBreakdown.Select(c => c.TotalExpenses.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))))];
    const incomes = [@Html.Raw(string.Join(",", Model.Summary.CategoryBreakdown.Select(c => c.TotalIncome.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))))];

    const colours = [
        "#2c3e50", "#e74c3c", "#3498db", "#2ecc71",
        "#f39c12", "#9b59b6", "#1abc9c", "#e67e22"
    ];

    const barCtx = document.getElementById("barChart").getContext("2d");
    new Chart(barCtx, {
        type: "bar",
        data: {
            labels: labels,
            datasets: [
                {
                    label: "Income",
                    data: incomes,
                    backgroundColor: "#2ecc71"
                },
                {
                    label: "Expenses",
                    data: expenses,
                    backgroundColor: "#e74c3c"
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: "top" }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return "€" + value.toFixed(2);
                        }
                    }
                }
            }
        }
    });

    const pieCtx = document.getElementById("pieChart").getContext("2d");
    new Chart(pieCtx, {
        type: "pie",
        data: {
            labels: labels,
            datasets: [{
                data: expenses,
                backgroundColor: colours
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: "bottom" },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ": €" + context.parsed.toFixed(2);
                        }
                    }
                }
            }
        }
    });
</script>