@page
@model Spaartje.Web.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2>Welcome to your Dashboard</h2>

<p>You are logged in as: <strong>@Model.UserEmail</strong></p>

@if (Model.IsAdmin)
{
    <div style="background-color: #fff3cd; border: 1px solid #ffc107; padding: 12px; border-radius: 4px; margin: 16px 0;">
        <strong>🔑 Admin Access:</strong> You have administrator privileges.
        <a asp-page="/Admin/Index" style="margin-left: 8px;">Go to Admin Panel →</a>
    </div>
}

<hr />

<p>This page is only visible to logged-in users.</p>
<p>This is where your financial dashboard content will go in future phases.</p>