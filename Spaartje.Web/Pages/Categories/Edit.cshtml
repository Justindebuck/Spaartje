@page
@model Spaartje.Web.Pages.Categories.EditModel

@{
    ViewData["Title"] = "Edit Category";
}

<a asp-page="/Categories/Index" style="display:inline-block; margin-bottom:16px; color:#2c3e50; text-decoration:none; font-size:14px;">
    ← Back to Categories
</a>

<h2>Edit Category</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div style="background:#f8f9fa; border:1px solid #ddd; padding:20px; border-radius:6px; max-width:500px;">
    <form method="post">

        @* Hidden field — sends the category Id with the POST so we know which one to update *@
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Input.Name">Category Name</label>
            <input asp-for="Input.Name" type="text" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Description">Description (optional)</label>
            <input asp-for="Input.Description" type="text" />
        </div>

        <div class="form-group">
    <label asp-for="Input.BudgetLimit">Monthly Budget Limit (€) — optional</label>
    <input asp-for="Input.BudgetLimit" type="number" step="0.01" min="0.01"
           placeholder="e.g. 300.00 — leave empty for no limit" />
    <span asp-validation-for="Input.BudgetLimit" class="text-danger"></span>
    <small style="color:#666; font-size:12px;">
        Set a monthly spending limit for this category. Leave empty to remove the limit.
    </small>
</div>

        <button type="submit">Save Changes</button>

        <a asp-page="/Categories/Index"
           style="margin-left:12px; color:#666; text-decoration:none; font-size:14px;">
            Cancel
        </a>

    </form>
</div>