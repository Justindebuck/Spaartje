@page
@model Spaartje.Web.Pages.Groups.EditModel

@{
    ViewData["Title"] = "Edit Group";
}

<div style="max-width:500px; margin:0 auto; padding:0 16px;">

    <a asp-page="/Groups/Details" asp-route-id="@Model.Id"
       style="display:inline-block; margin-bottom:16px; color:#2c3e50; text-decoration:none; font-size:14px;">
        ← Back to Group
    </a>

    <h2>Edit Group Settings</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-group">
            <label asp-for="Name">Group name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-top:16px;">
            <label asp-for="BudgetLimit">Budget limit (€ / month)</label>
            <input asp-for="BudgetLimit" type="number" step="0.01" min="0"
                   class="form-control"
                   placeholder="Leave blank for no limit" />
            <span asp-validation-for="BudgetLimit" class="text-danger"></span>
            <small style="color:#666;">Set to 0 or leave blank to remove the budget limit.</small>
        </div>

        <button type="submit" style="margin-top:20px;" class="btn btn-primary">
            Save Changes
        </button>

    </form>

</div>