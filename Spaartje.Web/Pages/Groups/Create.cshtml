@page
@model Spaartje.Web.Pages.Groups.CreateModel

@{
    ViewData["Title"] = "Create Group";
}

<div style="max-width:900px; margin:0 auto; padding:0 16px;">

    <a asp-page="/Groups/Index"
       style="display:inline-block; margin-bottom:16px; color:#2c3e50; text-decoration:none; font-size:14px;">
        ← Back to Groups
    </a>

    <h2>Create a New Group</h2>

    <div style="background:#f8f9fa; border:1px solid #ddd; padding:20px; border-radius:6px; max-width:500px;">
        <form method="post">

            <div class="form-group">
                <label asp-for="Input.Name">Group Name</label>
                <input asp-for="Input.Name" type="text" placeholder="e.g. Family Budget, Flatmates" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.BudgetLimit">Monthly Budget Limit (€) — optional</label>
                <input asp-for="Input.BudgetLimit" type="number" step="0.01" min="0.01"
                       placeholder="e.g. 1000.00 — leave empty for no limit" />
                <span asp-validation-for="Input.BudgetLimit" class="text-danger"></span>
            </div>

            <button type="submit">Create Group</button>

            <a asp-page="/Groups/Index"
               style="margin-left:12px; color:#666; text-decoration:none; font-size:14px;">
                Cancel
            </a>

        </form>
    </div>

</div>