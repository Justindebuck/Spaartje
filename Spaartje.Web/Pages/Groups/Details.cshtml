@page
@model Spaartje.Web.Pages.Groups.DetailsModel
@using Spaartje.Domain.Models

@{
    ViewData["Title"] = Model.Group?.Name ?? "Group Details";
}

<div style="max-width:900px; margin:0 auto; padding:0 16px;">

    <a asp-page="/Groups/Index"
       style="display:inline-block; margin-bottom:16px; color:#2c3e50; text-decoration:none; font-size:14px;">
        ← Back to Groups
    </a>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="background:#d4edda; border:1px solid #c3e6cb; padding:10px; border-radius:4px; margin-bottom:16px; color:#155724;">
            @Model.SuccessMessage
        </div>
    }

    <!-- Group Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <div>
            <h2 style="margin:0;">@Model.Group!.Name</h2>
            <div style="font-size:13px; color:#666; margin-top:4px;">
                @Model.Group.Members.Count member@(Model.Group.Members.Count == 1 ? "" : "s")
                @if (Model.IsManager)
                {
                    <span style="margin-left:8px; background:#2c3e50; color:white; padding:2px 8px; border-radius:4px; font-size:11px;">
                        You are the Manager
                    </span>
                }
            </div>
        </div>

        @if (Model.IsManager)
        {
            <form method="post" asp-page-handler="DeleteGroup"
                  onsubmit="return confirm('Are you sure you want to delete this group? This cannot be undone.');">
                <button type="submit"
                        style="background:#e74c3c; color:white; border:none; padding:8px 16px; border-radius:4px; cursor:pointer; font-size:14px;">
                    Delete Group
                </button>
            </form>
        }
    </div>

    <!-- Budget Progress Bar -->
    @if (Model.Group.BudgetLimit.HasValue)
    {
        var totalExpenses = Model.Transactions
            .Where(t => t.Type == TransactionType.Expense)
            .Sum(t => t.Amount);

        var percentage = Model.Group.BudgetLimit.Value > 0
            ? Math.Min((double)(totalExpenses / Model.Group.BudgetLimit.Value * 100), 100)
            : 0;

        var isOver = totalExpenses > Model.Group.BudgetLimit.Value;
        var barColour = isOver ? "#e74c3c" : percentage >= 75 ? "#f39c12" : "#2ecc71";

        <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px; margin-bottom:24px;">
            <h3 style="margin-top:0; font-size:16px; color:#2c3e50;">Group Budget</h3>

            <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                <span style="font-weight:bold;">@Model.Group.Name</span>
                <span style="color:@barColour;">
                    €@totalExpenses.ToString("F2") / €@Model.Group.BudgetLimit.Value.ToString("F2")
                    @if (isOver)
                    {
                        <span style="font-weight:bold;"> — OVER BUDGET</span>
                    }
                </span>
            </div>

            <div style="background:#e0e0e0; border-radius:4px; height:16px; overflow:hidden;">
                <div style="width:@((int)percentage)%; background:@barColour; height:100%; border-radius:4px;">
                </div>
            </div>

            @if (!isOver)
            {
                <div style="font-size:12px; color:#666; margin-top:4px;">
                    €@((Model.Group.BudgetLimit.Value - totalExpenses).ToString("F2")) remaining
                </div>
            }
            else
            {
                <div style="font-size:12px; color:#e74c3c; margin-top:4px;">
                    €@((totalExpenses - Model.Group.BudgetLimit.Value).ToString("F2")) over budget
                </div>
            }
        </div>
    }

    <div style="display:flex; gap:24px; flex-wrap:wrap;">

        <!-- LEFT COLUMN: Add Transaction + Transaction List -->
        <div style="flex:2; min-width:280px;">

            <!-- Add Transaction Form -->
            <div style="background:#f8f9fa; border:1px solid #ddd; padding:20px; border-radius:8px; margin-bottom:24px;">
                <h3 style="margin-top:0; font-size:16px;">Add Transaction</h3>

                <form method="post" asp-page-handler="AddTransaction">

                    <div class="form-group">
                        <label asp-for="TransactionInput.Description">Description</label>
                        <input asp-for="TransactionInput.Description" type="text" placeholder="e.g. Groceries" />
                        <span asp-validation-for="TransactionInput.Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TransactionInput.Amount">Amount (€)</label>
                        <input asp-for="TransactionInput.Amount" type="number" step="0.01" min="0.01" placeholder="0.00" />
                        <span asp-validation-for="TransactionInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TransactionInput.Date">Date</label>
                        <input asp-for="TransactionInput.Date" type="date" />
                    </div>

                    <div class="form-group">
                        <label asp-for="TransactionInput.Type">Type</label>
                        <select asp-for="TransactionInput.Type" asp-items="Model.TransactionTypeOptions"
                                style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                        </select>
                    </div>

                    <button type="submit">Add Transaction</button>

                </form>
            </div>

            <!-- Transactions List -->
            <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px;">
                <h3 style="margin-top:0; font-size:16px;">Transactions</h3>

                @if (!Model.Transactions.Any())
                {
                    <p style="color:#666;">No transactions yet. Add the first one above.</p>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                            <thead>
                                <tr style="background:#2c3e50; color:white;">
                                    <th style="padding:10px; text-align:left; width:110px;">Date</th>
                                    <th style="padding:10px; text-align:left;">Description</th>
                                    <th style="padding:10px; text-align:left; width:90px;">Type</th>
                                    <th style="padding:10px; text-align:right; width:100px;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in Model.Transactions)
                                {
                                    var isIncome = transaction.Type == TransactionType.Income;
                                    <tr style="border-bottom:1px solid #ddd;">
                                        <td style="padding:10px; white-space:nowrap;">
                                            @transaction.Date.ToString("dd/MM/yyyy")
                                        </td>
                                        <td style="padding:10px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                            @transaction.Description
                                        </td>
                                        <td style="padding:10px;">
                                            <span style="color:@(isIncome ? "#27ae60" : "#e74c3c"); font-weight:bold;">
                                                @transaction.Type
                                            </span>
                                        </td>
                                        <td style="padding:10px; text-align:right; color:@(isIncome ? "#27ae60" : "#e74c3c"); font-weight:bold; white-space:nowrap;">
                                            @(isIncome ? "+" : "-")€@transaction.Amount.ToString("F2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>

        <!-- RIGHT COLUMN: Members + Invite -->
        <div style="flex:1; min-width:220px;">

            <!-- Members List -->
            <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px; margin-bottom:24px;">
                <h3 style="margin-top:0; font-size:16px;">Members</h3>

                @foreach (var member in Model.Group.Members)
                {
                    var isOwner = member.UserId == Model.Group.OwnerId;

                    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #eee;">
                        <div>
                            <span style="font-size:14px;">@member.UserId</span>
                            @if (isOwner)
                            {
                                <span style="margin-left:6px; background:#2c3e50; color:white; padding:1px 6px; border-radius:4px; font-size:11px;">
                                    Manager
                                </span>
                            }
                        </div>

                        @if (Model.IsManager && !isOwner)
                        {
                            <form method="post" asp-page-handler="RemoveMember"
                                  onsubmit="return confirm('Remove this member?');"
                                  style="display:inline;">
                                <input type="hidden" name="memberUserId" value="@member.UserId" />
                                <button type="submit"
                                        style="background:none; border:none; color:#e74c3c; cursor:pointer; font-size:13px; padding:0;">
                                    Remove
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

            <!-- Invite Member — Manager only -->
            @if (Model.IsManager)
            {
                <div style="background:#f8f9fa; border:1px solid #ddd; border-radius:8px; padding:20px;">
                    <h3 style="margin-top:0; font-size:16px;">Invite Member</h3>

                    <form method="post" asp-page-handler="InviteMember">

                        <div class="form-group">
                            <label asp-for="InviteInput.Email">Email address</label>
                            <input asp-for="InviteInput.Email" type="email"
                                   placeholder="e.g. friend@example.com" />
                            <span asp-validation-for="InviteInput.Email" class="text-danger"></span>
                        </div>

                        <button type="submit">Add Member</button>

                    </form>
                </div>
            }

        </div>

    </div>

</div>