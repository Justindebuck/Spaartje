@page
@model Spaartje.Web.Pages.Admin.UsersModel

@{
    ViewData["Title"] = "All Users";
}

<h2>All Users</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

<p>Total registered users: <strong>@Model.Users.Count</strong></p>

@if (Model.Users.Any())
{
    <table style="width:100%; border-collapse: collapse; margin-top: 16px;">
        <thead>
            <tr style="background-color: #2c3e50; color: white;">
                <th style="padding: 10px; text-align: left;">Email</th>
                <th style="padding: 10px; text-align: left;">Username</th>
                <th style="padding: 10px; text-align: left;">Role</th>
                <th style="padding:10px; text-align:left;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px;">@user.Email</td>
                    <td style="padding: 10px;">@user.UserName</td>
                    <td style="padding: 10px;">@user.Role</td>
                    <td style="padding: 10px;">
                        @if (user.Role != "Admin")
                        {
                            <form method="post" asp-page-handler="DeleteUser"
                                  onsubmit="return confirm('Are you sure you want to delete @user.Email? This cannot be undone.');">
                                <input type="hidden" name="userIdToDelete" value="@user.Id" />
                                <button type="submit"
                                        style="background:#e74c3c; color:white; border:none; padding:4px 10px; border-radius:4px; cursor:pointer; font-size:13px;">
                                    Delete
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No users found.</p>
}

<p style="margin-top: 20px;">
    <a asp-page="/Admin/Index">← Back to Admin Panel</a>
</p>
