@page
@model Spaartje.Web.Pages.Admin.UsersModel

@{
    ViewData["Title"] = "All Users";
}

<h2>All Users</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}
else
{
<p>Total registered users: <strong>@Model.Users.Count</strong></p>

@if (Model.Users.Any())
{
    <table style="width:100%; border-collapse: collapse; margin-top: 16px;">
        <thead>
            <tr style="background-color: #2c3e50; color: white;">
                <th style="padding: 10px; text-align: left;">Email</th>
                <th style="padding: 10px; text-align: left;">Roles</th>
                <th style="padding: 10px; text-align: left;">Email Confirmed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px;">@user.Email</td>
                    <td style="padding: 10px;">
                        @if (user.Roles.Any())
                        {
                            @string.Join(", ", user.Roles)
                        }
                        else
                        {
                            <span style="color: #999;">No roles</span>
                        }
                    </td>
                    <td style="padding: 10px;">
                        @(user.EmailConfirmed ? "Yes" : "No")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No users found.</p>
}
}

<p style="margin-top: 20px;"><a asp-page="/Admin/Index">← Back to Admin Panel</a></p>