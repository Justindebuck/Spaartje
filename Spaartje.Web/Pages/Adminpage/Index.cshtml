@* Pages/Admin/Index.cshtml *@
@page
@model WEB.Pages.Admin.IndexModel
@using System.Security.Claims

<h2>Admin Panel</h2>
<p>Only administrators can see this page.</p>

@* Display current user info — useful for debugging *@
<div class="alert alert-info">
    Logged in as: <strong>@User.Identity?.Name</strong><br />
    Roles: <strong>@string.Join(", ", ((ClaimsPrincipal)User).Claims
        .Where(c => c.Type == ClaimTypes.Role)
        .Select(c => c.Value))</strong>
</div>